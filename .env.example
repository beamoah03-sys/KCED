# Copy this file to .env.local and fill in the values.
#   cp .env.example .env.local
#
# Supabase: Dashboard -> Project Settings -> API
# (for local development, `npx supabase start` prints these values)
# The anon key is safe in the browser: Row Level Security protects the data.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Mapbox token for the asset map: https://account.mapbox.com/access-tokens/
# Restrict it to your site's URL in the Mapbox dashboard.
VITE_MAPBOX_TOKEN=

# Shown on the public landing page
VITE_CONTACT_EMAIL=energy.office@knust.edu.gh
VITE_SECURITY_PHONE=0501347350
